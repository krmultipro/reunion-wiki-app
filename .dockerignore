# Application-only context. Git ignores do not protect Docker builds.
**
!Dockerfile
!.dockerignore
!app.py
!migrate.py
!requirements.txt
!reunion_wiki/
!reunion_wiki/**
!templates/
!templates/**
!static/
!static/**
!script/
!script/**
!tests/
!tests/**

# Deny runtime files even below an allowed application directory.
**/.env*
**/*.db
**/*.db-*
**/*.db.*
**/*.sqlite*
**/__pycache__/
**/*.pyc
**/uploads/
**/uploads_dev/
**/uploads_prod/
**/data/
**/data_dev/
**/data_prod/
**/backups/
**/logs/
**/certbot/
**/reports/
**/apercu-prive/
**/sephora.jpeg
maquettes/
monitoring/
.refonte-runtime/
static/report.html
static/reports/
